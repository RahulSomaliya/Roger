{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // No DOM: the main process and preload have no `window` or `document`. Code that hands
    // callbacks to a page (e2e/, qa/) is checked by tsconfig.e2e.json, which has DOM.
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "bench/**/*.ts",
    // Scripts under test/, such as the one that makes the backup fixture. eslint.config.mjs gives
    // the same folder Node globals; typed lint refuses a TypeScript file no tsconfig includes.
    "test/**/*.ts",
    "electron.vite.config.ts",
    "vite.preview.config.ts",
    "vitest.config.ts",
    "vitest.mac.config.ts"
  ]
}
