# Copy to .env (never commit .env). Both apps read their own section.

# ---- API (apps/api) ----
# Postgres connection used by the API and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roger
# Postgres connection used by the test suite (tables are truncated between tests). The suite
# drops and recreates the database every run and refuses any name not starting with roger_test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roger_test
# Shared secret the desktop app and MCP clients send as "Authorization: Bearer ...".
# Generate one with: openssl rand -hex 32. The API refuses to start with fewer than 16 characters
# or with this placeholder (any value starting with change-me).
ROGER_API_TOKEN=change-me-to-a-real-secret
# Speech-to-text preset the API hands out tokens for: a vendor and its model together, one row
# each in apps/api/src/roger_api/stt_vendors.py (STT_PRESETS). Changing either is this one line.
#   assemblyai      AssemblyAI Universal-Streaming English, Roger's vendor ($0.15 per stream-hour)
#   assemblyai-pro  AssemblyAI Universal-3.6 Pro ($0.45 per stream-hour)
#   deepgram        Deepgram nova-3, the second adapter ($0.462 per stream-hour)
#   soniox          Soniox stt-rt-v5, the optional third ($0.12 per stream-hour); the desktop
#                   refuses it at Start until its Soniox adapter lands
#   fake            no vendor: the desktop "transcribes" audio loudness
# For real transcripts set STT_PROVIDER=assemblyai and ASSEMBLYAI_API_KEY. STT_MODEL is retired:
# the API refuses to start while it has a value, so delete that line from an older .env.
STT_PROVIDER=fake
# Only needed for the assemblyai presets. Never ships in the desktop app.
ASSEMBLYAI_API_KEY=
# Only needed when STT_PROVIDER=deepgram. Never ships in the desktop app.
DEEPGRAM_API_KEY=
# Only needed when STT_PROVIDER=soniox. Never ships in the desktop app.
SONIOX_API_KEY=
# Lifetime of the vendor token handed to the desktop, in seconds (1..3600; at most 600 for the
# assemblyai presets, where it is only the window to open the stream).
STT_TOKEN_TTL_SECONDS=30
# USD per hour of one open stream without keyterms, returned to the desktop to estimate cost.
# Leave empty for the preset's list price (above); set it for a negotiated rate. When the workspace
# has a jargon list the API adds the vendor's keyterm surcharge on top (stt_vendors.py), so an
# all-in rate here would count the surcharge twice.
STT_PRICE_PER_HOUR_USD=
# Stream settings returned to the desktop with the token.
STT_LANGUAGE=en
STT_SAMPLE_RATE=16000
STT_ENCODING=linear16
# The one workspace every M1 request resolves to (M6 adds real workspaces).
DEFAULT_WORKSPACE_ID=805dd994-ff52-405c-a3cc-58f09b32a2dd
DEFAULT_WORKSPACE_NAME=Linkt
# "development" prints readable logs, "production" prints JSON logs.
APP_ENV=development
LOG_LEVEL=INFO
# Extra Host header values the MCP endpoint accepts besides localhost, comma-separated,
# e.g. roger.example.com,roger.example.com:*. Empty means localhost only.
MCP_ALLOWED_HOSTS=

# Notes and AI: the model that writes notes and answers chat about a meeting.
# "fake" writes notes from the transcript itself (no vendor, no cost); "openrouter" calls a real
# model through OpenRouter, only on zero-retention endpoints that do not train on calls.
# For real notes set NOTES_PROVIDER=openrouter and OPENROUTER_API_KEY.
NOTES_PROVIDER=fake
# Only needed when NOTES_PROVIDER=openrouter. Never ships in the desktop app.
OPENROUTER_API_KEY=
# OpenRouter model ids. Leave empty for the default, xiaomi/mimo-v2.6-pro.
NOTES_MODEL=
CHAT_MODEL=
# "off" asks the model not to reason (cheaper, faster); "on" lets it reason with up to
# NOTES_REASONING_TOKENS more output tokens, billed as output.
NOTES_REASONING=off
NOTES_REASONING_TOKENS=4096
# A meeting whose prompt is over this many tokens (estimated as characters / 4) is summarised in
# windows, then merged. A 2-hour call is about 30000.
NOTES_MAX_INPUT_TOKENS=200000
# The longest answer the model may write; a run that hits it fails and keeps the previous notes.
NOTES_MAX_OUTPUT_TOKENS=8192
# Seconds to wait for the provider to connect, or between two pieces of a streamed answer.
NOTES_TIMEOUT_SECONDS=120

# Calendar. "fake" (the default) serves built-in events with no Google client: every calendar
# screen and test runs on it. "google" needs the three values below; the setup steps are in
# docs/plans/M5-calendar.md, "Owner setup: Google Cloud".
CALENDAR_PROVIDER=fake
# The Google Cloud "Desktop app" OAuth client. Required when CALENDAR_PROVIDER=google. The secret
# never ships in the desktop app: Google wants it at its token endpoint, which only the API calls.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The consent screen's audience: "external_testing" (External, publishing status Testing: at most
# 100 test users, and each connection expires after 7 days; Roger warns from day 6),
# "external_production" (External, In production, once Google has verified the app) or "internal"
# (a Workspace-only project).
GOOGLE_OAUTH_AUDIENCE=external_testing
# Encrypts the stored Google refresh tokens in Postgres. Required when CALENDAR_PROVIDER=google, at
# least 32 characters: openssl rand -hex 32. Keep it: a lost or changed key means connecting again.
CALENDAR_TOKEN_KEY=
# A JSON file of events that replaces the fake provider's built-in ones. Empty: the built-in ones.
FAKE_CALENDAR_FILE=

# ---- Desktop (apps/desktop) ----
ROGER_API_URL=http://127.0.0.1:8000
# Same value as ROGER_API_TOKEN above.
ROGER_DESKTOP_API_TOKEN=change-me-to-a-real-secret
# Set to "fake" to run the desktop without the API choosing a vendor (development only).
ROGER_STT_PROVIDER=
ROGER_LOG_LEVEL=info
# Cost guards: bounds on billed speech-to-text time (apps/desktop/README.md, "Cost guards", has
# each default and why). Whole seconds or counts. Empty means the default; a value out of range
# blocks Start until it is fixed.
ROGER_STT_STALL_CLOSE_SECONDS=
ROGER_STT_REOPEN_BUFFER_SECONDS=
ROGER_STT_OPENS_PER_MINUTE=
ROGER_STT_OPENS_PER_MEETING=
ROGER_STT_REOPEN_BACKOFF_SECONDS=
ROGER_STT_REOPEN_BACKOFF_MAX_SECONDS=
ROGER_NO_SPEECH_STOP_SECONDS=
ROGER_MAX_RECORDING_SECONDS=
ROGER_QUIT_STOP_TIMEOUT_SECONDS=
ROGER_STT_VENDOR_IDLE_TIMEOUT_SECONDS=

# Benchmark (make bench, make stt-canary; docs/research/stt-benchmark.md). It also reads the
# Desktop settings above: the API URL and token (it asks the local API for every vendor token,
# like the app) and the cost guards.
# The standing STT test set: recordings of colleagues and their transcripts, so it never goes in
# git. An absolute path or ~/...; empty means ~/Roger-bench. A folder inside any git checkout is
# refused, through symlinks and worktrees too. `bench clip` keeps it mode 0700 and refuses to
# write while FileVault is off; that check reads the startup disk only, so keep it there.
ROGER_BENCH_DIR=
