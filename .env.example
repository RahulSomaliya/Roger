# Copy to .env (never commit .env). Both apps read their own section.

# ---- API (apps/api) ----
# Postgres connection used by the API and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roger
# Postgres connection used by the test suite (tables are truncated between tests).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roger_test
# Shared secret the desktop app and MCP clients send as "Authorization: Bearer ...".
# Generate one with: openssl rand -hex 32. The API refuses to start with fewer than 16 characters
# or with this placeholder (any value starting with change-me).
ROGER_API_TOKEN=change-me-to-a-real-secret
# Speech-to-text vendor the API hands out tokens for: "assemblyai" (Roger's vendor), "deepgram"
# (the second adapter) or "fake" (no vendor: the desktop "transcribes" audio loudness).
# For real transcripts set STT_PROVIDER=assemblyai and ASSEMBLYAI_API_KEY.
STT_PROVIDER=fake
# Only needed when STT_PROVIDER=assemblyai. Never ships in the desktop app.
ASSEMBLYAI_API_KEY=
# Only needed when STT_PROVIDER=deepgram. Never ships in the desktop app.
DEEPGRAM_API_KEY=
# Lifetime of the vendor token handed to the desktop, in seconds (1..3600; at most 600 for
# assemblyai, where it is only the window to open the stream).
STT_TOKEN_TTL_SECONDS=30
# Stream settings returned to the desktop with the token. Leave STT_MODEL empty for the provider's
# English streaming model (assemblyai: universal-streaming-english, deepgram: nova-3). An older
# .env that says STT_MODEL=nova-3 must drop it when switching to assemblyai: the API refuses to
# start with another vendor's model.
STT_MODEL=
# USD per hour of one open stream, returned to the desktop to estimate cost. Leave empty for the
# vendor's list price for STT_MODEL (assemblyai universal-streaming-english: 0.15, deepgram nova-3:
# 0.462); set it for a negotiated rate or a model the API has no price for.
STT_PRICE_PER_HOUR_USD=
STT_LANGUAGE=en
STT_SAMPLE_RATE=16000
STT_ENCODING=linear16
# The one workspace every M1 request resolves to (M6 adds real workspaces).
DEFAULT_WORKSPACE_ID=805dd994-ff52-405c-a3cc-58f09b32a2dd
DEFAULT_WORKSPACE_NAME=Linkt
# "development" prints readable logs, "production" prints JSON logs.
APP_ENV=development
LOG_LEVEL=INFO
# Extra Host header values the MCP endpoint accepts besides localhost, comma-separated,
# e.g. roger.example.com,roger.example.com:*. Empty means localhost only.
MCP_ALLOWED_HOSTS=

# ---- Desktop (apps/desktop) ----
ROGER_API_URL=http://127.0.0.1:8000
# Same value as ROGER_API_TOKEN above.
ROGER_DESKTOP_API_TOKEN=change-me-to-a-real-secret
# Set to "fake" to run the desktop without the API choosing a vendor (development only).
ROGER_STT_PROVIDER=
ROGER_LOG_LEVEL=info
# Cost guards: bounds on billed speech-to-text time (apps/desktop/README.md, "Cost guards", has
# each default and why). Whole seconds or counts. Empty means the default; a value out of range
# blocks Start until it is fixed.
ROGER_STT_STALL_CLOSE_SECONDS=
ROGER_STT_REOPEN_BUFFER_SECONDS=
ROGER_STT_OPENS_PER_MINUTE=
ROGER_STT_OPENS_PER_MEETING=
ROGER_STT_REOPEN_BACKOFF_SECONDS=
ROGER_STT_REOPEN_BACKOFF_MAX_SECONDS=
ROGER_NO_SPEECH_STOP_SECONDS=
ROGER_MAX_RECORDING_SECONDS=
ROGER_QUIT_STOP_TIMEOUT_SECONDS=
ROGER_STT_VENDOR_IDLE_TIMEOUT_SECONDS=
