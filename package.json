{
  "name": "roger",
  "private": true,
  "description": "Roger: a Granola-style meeting notes app for the Linkt team. Monorepo root.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "desktop": "pnpm --filter @roger/desktop",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check"
  }
}
